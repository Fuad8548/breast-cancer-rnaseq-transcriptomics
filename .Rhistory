counts <- read.delim(
"data/processed/counts_T1_T3.tsv",
row.names = 1,
check.names = FALSE
)
keep <- rowSums(counts >= 10) >= 24
table(keep)
counts_filtered <- counts[keep, ]
dim(counts_filtered)
write.table(
counts_filtered,
"data/processed/counts_T1_T3_filtered.tsv",
sep = "\t",
quote = FALSE,
col.names = NA
)
library(DESeq2)
metadata <- read.csv(
    "data/processed/metadata_T1_T3.csv",
    row.names = 1,
    check.names = FALSE
)
head(metadata)
metadata$patient_id <- factor(metadata$patient_id)
metadata$timepoint <- factor(
    metadata$timepoint,
    levels = c("T1", "T3")
)
metadata$patient_id <- factor(metadata$patient_id)
metadata$timepoint <- factor(
    metadata$timepoint,
    levels = c("T1", "T3")
)
all(rownames(metadata) == colnames(counts_filtered))
dds <- DESeqDataSetFromMatrix(
    countData = counts_filtered,
    colData = metadata,
    design = ~ patient_id + timepoint
)
q()
