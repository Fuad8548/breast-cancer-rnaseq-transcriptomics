counts <- read.delim(
"data/processed/counts_T1_T3.tsv",
row.names = 1,
check.names = FALSE
)
keep <- rowSums(counts >= 10) >= 24
table(keep)
counts_filtered <- counts[keep, ]
dim(counts_filtered)
write.table(
counts_filtered,
"data/processed/counts_T1_T3_filtered.tsv",
sep = "\t",
quote = FALSE,
col.names = NA
)
library(DESeq2)
metadata <- read.csv(
    "data/processed/metadata_T1_T3.csv",
    row.names = 1,
    check.names = FALSE
)
head(metadata)
metadata$patient_id <- factor(metadata$patient_id)
metadata$timepoint <- factor(
    metadata$timepoint,
    levels = c("T1", "T3")
)
metadata$patient_id <- factor(metadata$patient_id)
metadata$timepoint <- factor(
    metadata$timepoint,
    levels = c("T1", "T3")
)
all(rownames(metadata) == colnames(counts_filtered))
dds <- DESeqDataSetFromMatrix(
    countData = counts_filtered,
    colData = metadata,
    design = ~ patient_id + timepoint
)
q()
library(clusterProfiler)
library(org.Hs.eg.db)
gene_list <- readRDS(
    "data/processed/gene_list_T3_vs_T1_Entrez.rds"
)
length(gene_list)
head(gene_list)
gsea_go_bp <- gseGO(
    geneList = gene_list,
    OrgDb = org.Hs.eg.db,
    keyType = "ENTREZID",
    ont = "BP",
    minGSSize = 10,
    maxGSSize = 500,
    pvalueCutoff = 0.05,
    pAdjustMethod = "BH",
    verbose = TRUE
)
nrow(as.data.frame(gsea_go_bp))
sum(as.data.frame(gsea_go_bp)$p.adjust < 0.05, na.rm = TRUE)
gsea_go_simplified <- simplify(
    gsea_go_bp,
    cutoff = 0.7,
    by = "p.adjust",
    select_fun = min
)
go_simple_df <- as.data.frame(gsea_go_simplified)
nrow(go_simple_df)
t1_top <- go_simple_df[
    go_simple_df$NES < 0 & go_simple_df$p.adjust < 0.05,
]
t1_top <- t1_top[
    order(t1_top$p.adjust),
]
t1_top <- t1_top[
    1:min(10, nrow(t1_top)),
]
t1_top[
    ,
    c("ID", "Description", "NES", "p.adjust", "core_enrichment")
]
t1_long <- t1_top
t1_long$core_enrichment <- strsplit(
    t1_long$core_enrichment,
    "/"
)
t1_long <- t1_long[
    rep(
        seq_len(nrow(t1_long)),
        lengths(t1_long$core_enrichment)
    ),
]
t1_long$ENTREZID <- unlist(
    t1_long$core_enrichment
)
t1_long$core_enrichment <- NULL
library(DESeq2)
t1_long <- t1_top
t1_long$core_enrichment <- strsplit(
    t1_long$core_enrichment,
    "/"
)
t1_long <- t1_long[
    rep(
        seq_len(nrow(t1_long)),
        lengths(t1_long$core_enrichment)
    ),
]
t1_long$ENTREZID <- unlist(
    t1_long$core_enrichment
)
t1_long$core_enrichment <- NULL
# 1. Duplicate the dataframe by splitting the column directly using splitStackShape
# Or stick to pure base R by handling the unlist safely:
# Create the list column
split_list <- strsplit(t1_top$core_enrichment, "/")
# Replicate the entire dataframe rows based on the split lengths
t1_long <- t1_top[rep(seq_len(nrow(t1_top)), lengths(split_list)), ]
# Overwrite/Create the columns safely
t1_long$ENTREZID <- unlist(split_list)
t1_long$core_enrichment <- NULL  # Drop the old column if no longer needed
t1_long <- unique(
    t1_long[
        ,
        c(
            "Description",
            "NES",
            "p.adjust",
            "ENTREZID"
        )
    ]
)
gene_map_t1 <- AnnotationDbi::select(
    org.Hs.eg.db,
    keys = unique(t1_long$ENTREZID),
    columns = c("SYMBOL", "GENENAME"),
    keytype = "ENTREZID"
)
gene_map_t1 <- gene_map_t1[
    !duplicated(gene_map_t1$ENTREZID),
]
t1_long <- merge(
    t1_long,
    gene_map_t1,
    by = "ENTREZID",
    all.x = TRUE
)
t1_frequency <- aggregate(
    Description ~ ENTREZID + SYMBOL + GENENAME,
    data = t1_long,
    FUN = length
)
names(t1_frequency)[4] <- "n_top_GO_terms"
t1_frequency <- t1_frequency[
    order(-t1_frequency$n_top_GO_terms),
]
head(t1_frequency, 30)
de_results <- read.csv(
    "results/differential_expression/DESeq2_T3_vs_T1_all_genes.csv",
    check.names = FALSE
)
de_results <- read.csv(
    "results/differential_expression/DESeq2_T3_vs_T1_all_genes.csv",
    check.names = FALSE
)
names(de_results)
de_annotated <- read.csv(
    "results/differential_expression/DESeq2_T3_vs_T1_annotated.csv",
    check.names = FALSE
)
de_results <- read.csv(
    "results/differential_expression/DESeq2_T3_vs_T1_all_genes.csv",
    check.names = FALSE
)
names(de_results)
de_results$ENSEMBL <- sub(
    "\\..*$",
    "",
    de_results$gene_id
)
de_map <- AnnotationDbi::select(
    org.Hs.eg.db,
    keys = unique(de_results$ENSEMBL),
    columns = "ENTREZID",
    keytype = "ENSEMBL"
)
de_map <- de_map[
    !is.na(de_map$ENTREZID),
]
de_map <- de_map[
    !duplicated(de_map$ENSEMBL),
]
de_results <- merge(
    de_results,
    de_map,
    by = "ENSEMBL",
    all.x = TRUE
)
de_entrez <- de_results[
    !is.na(de_results$ENTREZID),
]
de_entrez <- de_entrez[
    order(
        de_entrez$ENTREZID,
        -abs(de_entrez$stat)
    ),
]
de_entrez <- de_entrez[
    !duplicated(de_entrez$ENTREZID),
]
t1_frequency
t1_candidates <- merge(
    t1_frequency,
    de_entrez[
        ,
        c(
            "ENTREZID",
            "baseMean",
            "log2FoldChange",
            "pvalue",
            "padj",
            "stat"
        )
    ],
    by = "ENTREZID",
    all.x = TRUE
)
t1_candidates <- t1_candidates[
    order(
        -t1_candidates$n_top_GO_terms,
        t1_candidates$log2FoldChange
    ),
]
t1_candidates[
    ,
    c(
        "SYMBOL",
        "GENENAME",
        "n_top_GO_terms",
        "baseMean",
        "log2FoldChange",
        "pvalue",
        "padj"
    )
]
!duplicated(de_map$ENSEMBL)
!duplicated(de_entrez$ENTREZID)
head(
    t1_candidates[
        order(
            -t1_candidates$n_top_GO_terms,
            t1_candidates$log2FoldChange
        ),
        c(
            "SYMBOL",
            "GENENAME",
            "n_top_GO_terms",
            "baseMean",
            "log2FoldChange",
            "pvalue",
            "padj"
        )
    ],
    30
)
head(
    t1_candidates[
        order(
            -t1_candidates$n_top_GO_terms,
            t1_candidates$log2FoldChange
        ),
        c(
            "SYMBOL",
            "n_top_GO_terms",
            "log2FoldChange",
            "pvalue",
            "padj"
        )
    ],
    20
)
q()
